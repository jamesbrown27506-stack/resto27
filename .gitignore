# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dev-server.log

# env files (can opt-in for committing if needed)
.env*
# ...except the template, which carries no secrets and is what a new
# deployment is configured from.
!.env.example

# runtime uploads — keep the folders, ignore what lands in them
/public/uploads/*
!/public/uploads/.gitkeep

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Temporary fetch instrumentation used to count Supabase round trips.
instrument.cjs
loadtest.mjs

# SEO audit output — regenerable reports plus raw HTML captures and screenshots.
# Kept local: 5 MB of crawl artefacts does not belong in application history.
/resto237.online-audit/
