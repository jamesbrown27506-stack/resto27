# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dev-server.log

# env files (can opt-in for committing if needed)
.env*
# ...except the template, which carries no secrets and is what a new
# deployment is configured from.
!.env.example

# runtime uploads — keep the folders, ignore what lands in them
/public/uploads/*
!/public/uploads/.gitkeep

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Temporary fetch instrumentation used to count Supabase round trips.
instrument.cjs
loadtest.mjs

# SEO audit output — regenerable reports plus raw HTML captures and screenshots.
# Kept local: 5 MB of crawl artefacts does not belong in application history.
/resto237.online-audit/

# Capacitor native build products and machine-local settings. Native source is committed.
/android/.gradle/
/android/.idea/
/android/build/
/android/app/build/
/android/local.properties
/ios/App/DerivedData/
/ios/App/Pods/
/ios/App/App.xcworkspace/xcuserdata/
*.xcuserstate
*.jks
*.keystore
*.p12
*.mobileprovision
# Signing passwords for the release key above. Back both up outside the repo:
# losing them means installed APKs can never be updated in place.
/android/keystore.properties

# Download these native Firebase credentials per environment; never commit them.
/android/app/google-services.json
/ios/App/App/GoogleService-Info.plist

# Throwaway browser profiles from mobile QA runs. They hold cookies, saved
# passwords and session storage — never commit them.
/.chrome-mobile-qa/
/.edge-mobile-qa*/

# Supabase CLI machine-local project metadata.
/supabase/.temp/
