# ═══════════════════════════════════════════════════════════════════════════
#  Environment. Copy to .env.local for development; enter the same keys in
#  Vercel → Project → Settings → Environment Variables for production.
#
#  NEVER commit real values. This file is the SHAPE, not the secrets.
# ═══════════════════════════════════════════════════════════════════════════


# ── Supabase ───────────────────────────────────────────────────────────────
# Both NEXT_PUBLIC_ values are safe in the browser by design.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# ───────────────────────────────────────────────────────────────────────────
#  SERVER-SIDE ONLY. This key BYPASSES ROW LEVEL SECURITY ENTIRELY — it can
#  read and write every restaurant's data. Never prefix it NEXT_PUBLIC_, never
#  import it into a Client Component, never paste it into a chat, an issue or
#  a screenshot. If it leaks, rotate it immediately in the Supabase dashboard.
# ───────────────────────────────────────────────────────────────────────────
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx


# ── Where this deployment lives ────────────────────────────────────────────
# test → emailed links point at APP_URL_TEST (or the incoming request host)
# live → emailed links point at APP_URL_LIVE, and the request is NEVER trusted
#        (a forged Host header would otherwise put a real password-reset token
#        on an attacker's domain).
#
# Leave APP_MODE unset on Vercel: it infers `live` from NODE_ENV=production,
# and siteUrl() falls back to VERCEL_PROJECT_PRODUCTION_URL automatically.
APP_MODE=test
APP_URL_TEST=http://localhost:3000
APP_URL_LIVE=https://your-domain.cm

# Used for canonical URLs and metadataBase.
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# ── Email (SMTP) ───────────────────────────────────────────────────────────
# Gmail works with an App Password, but caps around 500/day and is throttled
# hard from datacenter IPs. Move to Resend or Postmark before real volume.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-16-char-app-password
MAIL_FROM=Resto237 <you@gmail.com>

# Optional. When set AND APP_MODE=test, every message is diverted here instead
# of reaching the real recipient. Leave EMPTY to deliver normally in test.
MAIL_TEST_INBOX=


# ── CamerPay ───────────────────────────────────────────────────────────────
# The callback URL must be HTTPS and publicly reachable, which is why this is
# configured after the first deploy: https://your-domain.cm/api/webhooks/camerpay
CAMERPAY_BASE_URL=https://api.camerpay.net

# TWO WAYS TO AUTHENTICATE — set EITHER of these, not necessarily both.
#
# 1. A token issued by CamerPay. No password anywhere, no login call. This is
#    the simplest option and the one to ask support for if `inscription`
#    refuses to open an account for you.
CAMERPAY_TOKEN=

# 2. Or account number + password, exchanged for a session token on each cold
#    start. The number is 9 digits starting with 6, no +237.
CAMERPAY_ACCOUNT_NUMBER=
CAMERPAY_PASSWORD=
