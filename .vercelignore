# Local secrets and generated files must never enter Vercel source uploads.
.git
.vercel
.env*
node_modules
.next
out
build
coverage
*.tsbuildinfo
*.log
*.pem
*.p8
*.p12
*.jks
*.keystore
*firebase-adminsdk*.json
*service-account*.json

